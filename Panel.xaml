<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="2077 主题控制台" Width="880" Height="780" MinWidth="720" MinHeight="640" Background="#10151A" Foreground="#EDF0F3" FontFamily="Microsoft YaHei UI" FontSize="14" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#AFBBC5"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#202C35"/><Setter Property="Foreground" Value="#EDF0F3"/><Setter Property="BorderBrush" Value="#536371"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,10"/><Setter Property="MinHeight" Value="42"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#5DE4E1"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#FFFFFF"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#111A21"/><Setter Property="Foreground" Value="#D9E3EB"/><Setter Property="BorderBrush" Value="#35434F"/><Setter Property="SelectionBrush" Value="#287778"/><Setter Property="Padding" Value="12"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,8,20,8"/></Style>
    <Style x:Key="Value" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
  </Window.Resources>
  <DockPanel Margin="30,24,30,22">
    <Grid DockPanel.Dock="Top" Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="0,0,16,0"><TextBlock x:Name="TitleText" Text="2077 主题控制台" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="SubtitleText" Text="深潜协议 · Codex 桌面外观" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
      <StackPanel Grid.Column="1"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="LanguageLabel" Text="语言" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource Muted}" FontSize="12"/><ComboBox x:Name="LanguagePicker" Width="112" MinHeight="30" Foreground="#17212A" AutomationProperties.Name="选择界面语言"><ComboBoxItem Content="中文" Tag="zh-CN"/><ComboBoxItem Content="English" Tag="en"/></ComboBox></StackPanel><Button x:Name="RefreshButton" Content="刷新状态" HorizontalAlignment="Right" Margin="0,8,0,0" AutomationProperties.Name="刷新当前连接和主题状态"/></StackPanel>
      <TextBlock x:Name="LanguageNotice" Grid.Row="1" Grid.ColumnSpan="2" TextWrapping="Wrap" Foreground="#FCA9AD" FontSize="12" Margin="0,10,0,0" Visibility="Collapsed"/>
    </Grid>
    <TextBlock x:Name="Footer" DockPanel.Dock="Bottom" Text="主题保留在当前 Codex 窗口，重启后可在这里重新开启。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,18,0,0"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,8,0">
        <Border Background="#211A21" BorderBrush="#5D3541" BorderThickness="1" Padding="24">
          <StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Headline" Text="正在读取状态" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap"/><Border Grid.Column="1" BorderBrush="#85515B" BorderThickness="1" Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Top"><TextBlock x:Name="StatusTag" Text="检测中" Foreground="#FCA9AD" FontSize="12"/></Border></Grid>
            <TextBlock x:Name="Detail" Text="检查 Codex 连接、主题状态和本机运行环境。" TextWrapping="Wrap" LineHeight="23" Foreground="#D6BBC2" Margin="0,12,0,22"/>
            <WrapPanel><Button x:Name="OnButton" Content="开启 2077 主题" Background="#F06472" Foreground="#171418" BorderBrush="#F06472" FontWeight="SemiBold" Margin="0,0,12,8" IsEnabled="False"/><Button x:Name="OffButton" Content="关闭主题" Margin="0,0,12,8" IsEnabled="False"/><Button x:Name="LaunchButton" Content="启动主题连接" Margin="0,0,0,8" IsEnabled="False"/></WrapPanel>
            <StackPanel x:Name="TargetPanel" Visibility="Collapsed" Margin="0,10,0,0"><TextBlock x:Name="TargetLabel" Text="选择要操作的 Codex 窗口" Margin="0,0,0,8"/><ComboBox x:Name="TargetPicker" MinHeight="36" Foreground="#17212A" AutomationProperties.Name="要操作的 Codex 窗口"/></StackPanel>
          </StackPanel>
        </Border>
        <Grid Margin="0,20,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock x:Name="ConnectionLabel" Text="Codex 连接" Style="{StaticResource Label}"/><TextBlock x:Name="ConnectionValue" Grid.Column="1" Text="正在检查" Style="{StaticResource Value}"/>
          <TextBlock x:Name="VersionLabel" Grid.Row="1" Text="应用版本" Style="{StaticResource Label}"/><TextBlock x:Name="VersionValue" Grid.Row="1" Grid.Column="1" Text="正在检查" Style="{StaticResource Value}"/>
          <TextBlock x:Name="ThemeLabel" Grid.Row="2" Text="主题状态" Style="{StaticResource Label}"/><TextBlock x:Name="ThemeValue" Grid.Row="2" Grid.Column="1" Text="尚未确认" Style="{StaticResource Value}"/>
          <TextBlock x:Name="RuntimeLabel" Grid.Row="3" Text="运行环境" Style="{StaticResource Label}"/><TextBlock x:Name="NodeValue" Grid.Row="3" Grid.Column="1" Text="正在检查" Style="{StaticResource Value}"/>
        </Grid>
        <Border Height="1" Background="#35404A" Margin="0,0,0,18"/>
        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="LogLabel" Text="运行记录" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="CheckButton" Grid.Column="1" Content="检查主题文件" Padding="12,7" MinHeight="34" FontSize="12"/></Grid>
        <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="104" FontSize="12" AutomationProperties.Name="操作时间和运行结果"/>
        <Expander x:Name="DiagnosticExpander" Header="查看诊断详情" Foreground="#CCD7DF" Margin="0,16,0,0"><TextBox x:Name="DiagnosticBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="220" Margin="0,12,0,0" FontSize="12" AutomationProperties.Name="连接地址及错误详情"/></Expander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
